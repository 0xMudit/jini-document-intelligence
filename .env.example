PORT=8788
NODE_ENV=production
LOG_LEVEL=info

# Leave empty when the frontend and API share an origin. For a separate API,
# use a full origin such as http://localhost:8788.
VITE_API_BASE=

# Comma-separated list of extra origins allowed for CORS (same-origin works by default).
ALLOWED_ORIGINS=
COOKIE_SECURE=false

# Set to "true" when behind a reverse proxy (nginx, Caddy, etc.)
TRUST_PROXY=false

# Optional seeded-account overrides for local testing.
TEST_USER_PASSWORD=JiniTest123!
HR_TEST_PASSWORD=JiniHR123!
GUEST_TEST_PASSWORD=JiniGuest123!

# Where the server keeps its runtime data (SQLite DB + your local video library).
# Point videos at a folder of <key>.mp4 files; titles using those keys stream them with
# range requests. Any other key either maps to a public sample clip or returns 404.
# DATA_DIR=data